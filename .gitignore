!SKILL.md


# -----------------------------------------------------------------------------
# Test fixtures — intentional exceptions
# -----------------------------------------------------------------------------
# HQE acceptance/security tests may need committed fake credentials, .env files,
# ignored-file examples, archives, generated-looking paths, or suspicious names.
# These exceptions allow those files under the controlled fixture trees.
#
# Never place real credentials in fixtures.

!tests/
!tests/fixtures/
!tests/fixtures/**
!tests/acceptance/
!tests/acceptance/**

# Allow explicit fake environment/credential fixture files.
!tests/fixtures/**/.env
!tests/fixtures/**/.env.*
!tests/fixtures/**/*.pem
!tests/fixtures/**/*.key
!tests/fixtures/**/*.token
!tests/fixtures/**/credentials.json
!tests/fixtures/**/secrets.json
!tests/fixtures/**/*.zip

!tests/acceptance/**/.env
!tests/acceptance/**/.env.*
!tests/acceptance/**/*.pem
!tests/acceptance/**/*.key
!tests/acceptance/**/*.token
!tests/acceptance/**/credentials.json
!tests/acceptance/**/secrets.json
!tests/acceptance/**/*.zip


# -----------------------------------------------------------------------------
# Repository files that must remain tracked
# -----------------------------------------------------------------------------

!.gitignore
!.gitattributes
!.editorconfig
!.github/
!.github/**
!README.md
!LICENSE
!NOTICE
!VERSION
!CHANGELOG.md
!SKILL.md
!pyproject.toml
!requirements.txt
!requirements-dev.txt
!uv.lock
!poetry.lock
!Pipfile.lock
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!bun.lockb
!Cargo.toml
!Cargo.lock


# Ensure cache debris is never tracked
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime state & generated audit reports
.hqe/
.hqe-cache/
.hqe-state/
audit-output/
HQE_REPORT.md
HQE_FINDINGS.json
HQE_RUN_MANIFEST.json
HQE_SESSION_LOG.json
HQE_REDACTION_LOG.json
HQE_RISK_REGISTER.md
HQE_MASTER_TODO.md
HQE_SECURITY_POSTURE.md
HQE_RELIABILITY.md
HQE_HANDOFF.md

# Development generated scratchpads
development/generated/*
!development/generated/.gitkeep

# Development audit reports (keep historical reports; ignore newly generated ones)
development/audits/*.md

# Temporary and backup files
*.tmp
*.bak
*.old
*.log

# Release archives
*.zip
*.tar.gz
*.tgz

# =============================================================================
# End Skill-HQE .gitignore
