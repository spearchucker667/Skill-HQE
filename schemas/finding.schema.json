{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HQE Finding",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HQE-(BOOT|SEC|BUG|REL|PERF|UX|DX|DOC|DEBT|DEPS)-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "BOOT",
        "SEC",
        "BUG",
        "REL",
        "PERF",
        "UX",
        "DX",
        "DOC",
        "DEBT",
        "DEPS"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "FACT",
        "INFERENCE",
        "HYPOTHESIS",
        "NEEDS_VERIFICATION"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "STRONGLY_SUPPORTED",
        "SUSPECTED",
        "NOT_REPRODUCED",
        "FIXED",
        "REOPENED",
        "SUPERSEDED"
      ]
    },
    "affected_component": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer"
          },
          "end_line": {
            "type": "integer"
          },
          "anchor": {
            "type": "string"
          },
          "grep_signature": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "path",
              "start_line",
              "end_line",
              "snippet"
            ]
          },
          {
            "required": [
              "path",
              "anchor",
              "grep_signature",
              "snippet"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "observed_behavior": {
      "type": "string"
    },
    "expected_behavior": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "reproduction": {
      "type": ["string", "null"]
    },
    "remediation": {
      "type": "string"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effort": {
      "type": "string",
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "regression_risk": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "related_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exploitability": {
      "type": "string"
    },
    "blast_radius": {
      "type": "string"
    },
    "likelihood": {
      "type": "string"
    },
    "likelihood_justification": {
      "type": "string"
    },
    "exposure_evidence": {
      "type": "string"
    },
    "taint_chain": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_boundary": {
          "type": "string"
        },
        "sink": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "transforms",
        "validation_boundary",
        "sink",
        "impact"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "category",
    "severity",
    "confidence",
    "status",
    "evidence",
    "effort",
    "affected_component",
    "root_cause",
    "impact",
    "remediation",
    "validation",
    "regression_risk"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH"
            ]
          }
        }
      },
      "then": {
        "required": [
          "preconditions",
          "exploitability",
          "blast_radius",
          "likelihood",
          "likelihood_justification",
          "exposure_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "SEC"
          }
        }
      },
      "then": {
        "required": [
          "taint_chain"
        ]
      }
    }
  ]
}